{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeetingEndedPayload",
  "description": "Cross-service contract emitted by services/media and ingested by services/workos when a meeting concludes.",
  "type": "object",
  "required": [
    "meeting_id",
    "org_id",
    "title",
    "started_at",
    "ended_at",
    "language",
    "participants",
    "transcript"
  ],
  "properties": {
    "meeting_id": {
      "type": "string",
      "description": "Unique identifier for the meeting."
    },
    "org_id": {
      "type": "string",
      "description": "Clerk organization identifier for multi-tenant isolation."
    },
    "title": {
      "type": "string",
      "description": "Meeting title or subject."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 start timestamp."
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 end timestamp."
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Primary language of the meeting transcript."
    },
    "participants": {
      "type": "array",
      "description": "List of attendees mapped via Clerk.",
      "items": {
        "type": "object",
        "required": ["clerk_user_id", "display_name", "email"],
        "properties": {
          "clerk_user_id": { "type": "string" },
          "display_name": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    },
    "transcript": {
      "type": "array",
      "description": "Diarized transcript segments with speaker attribution and timestamps.",
      "items": {
        "type": "object",
        "required": ["speaker", "start", "end", "text"],
        "properties": {
          "speaker": { "type": "string" },
          "speaker_user_id": {
            "type": ["string", "null"]
          },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": ["string", "null"],
      "description": "Optional human-readable meeting summary generated by Gemini."
    },
    "recording_url": {
      "type": ["string", "null"],
      "description": "URL to the recording video in Cloudinary/Stream storage."
    }
  }
}
