{
  "name": "horizon-veridian",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "demo": "node scripts/run_demo.mjs",
    "live": "npm run build && node scripts/run_demo.mjs --live",
    "live:dev": "node scripts/run_demo.mjs --live --dev",
    "verify-keys": "python scripts/verify_keys.py",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "type-check": "npm --prefix apps/web run type-check",
    "contracts:generate": "python packages/contracts/scripts/generate_contracts.py",
    "contracts:check": "python packages/contracts/scripts/generate_contracts.py --check",
    "seed": "python -m db.seed.seed_cli",
    "test:contracts": "npm run contracts:check"
  }
}
