# ==============================================================================
# Horizon Veridian — Environment Variables Template (.env.example)
# Copy this file to .env and fill in real values. NEVER commit secrets.
# ==============================================================================

# --- Shared & Runtime ---
APP_ENV=development
DEMO_MODE=true
SHARED_HMAC_SECRET=replace_with_a_secure_random_hex_secret

# --- Service Ports & URLs ---
PORT=3000
MEDIA_PORT=5001
WORKOS_PORT=8000
FRONTEND_URL=http://localhost:3000
MEDIA_URL=http://localhost:5001
WORKOS_URL=http://localhost:8000
NEXT_PUBLIC_WORKOS_URL=http://localhost:8000
NEXT_PUBLIC_MEDIA_URL=http://localhost:5001
NEXT_PUBLIC_DEMO_MODE=true

# --- Gnani AI Sovereign Stack (Vachana) ---
GNANI_API_KEY=placeholder_gnani_api_key
GNANI_TOKEN=placeholder_gnani_token
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_TIMBRE_VOICE=Deepak
EVON_MODEL_NAME=gnani-ai/evon-30b
EVON_API_BASE=https://api-inference.huggingface.co/models/gnani-ai/evon-30b/v1
EVON_API_KEY=placeholder_hf_or_evon_token

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# --- Stream.io Video & Audio Calling ---
NEXT_PUBLIC_STREAM_API_KEY=placeholder_stream_public_key
STREAM_API_KEY=placeholder_stream_api_key
STREAM_API_SECRET=placeholder_stream_api_secret

# --- Supabase & Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_supabase_anon_key
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# --- AI Models (Never hardcode in code) ---
GEMINI_API_KEY=placeholder_gemini_api_key
NVIDIA_API_KEY=placeholder_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_EXTRACTION_MODEL=gemini-3-flash-preview
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
LLM_REASONING_MODEL=meta/llama-3.1-70b-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIM=1024

# --- Compliance Thresholds & Capacity Limits ---
SECURITY_THRESHOLD=0.50
FINANCE_THRESHOLD=0.50
COMMIT_MATCH_THRESHOLD=0.75
COMMIT_MATCH_MARGIN=0.15
CAPACITY_LIMIT=10
CAPACITY_NEW_HIRE_LIMIT=2
CHECKIN_INTERVAL_SECONDS=60

# --- Issue Tracking: Jira ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=placeholder_jira_api_token
JIRA_PROJECT_KEY=VER

# --- Communications: Slack ---
SLACK_BOT_TOKEN=xoxb-placeholder-slack-token
SLACK_SIGNING_SECRET=placeholder_slack_signing_secret
SLACK_MANAGER_CHANNEL=#product-team
SLACK_MANAGER_HANDLE=@manager
SLACK_SUMMARY_CHANNEL=#product-team

# --- Source Control: GitHub ---
GITHUB_WEBHOOK_SECRET=placeholder_github_webhook_secret

# --- Media Processing & Storage ---
CLOUDINARY_CLOUD_NAME=placeholder_cloudinary_cloud_name
CLOUDINARY_API_KEY=placeholder_cloudinary_api_key
CLOUDINARY_API_SECRET=placeholder_cloudinary_api_secret
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
TRANSCRIBER=gnani_prisma
TTS_PROVIDER=gnani_timbre
WHISPERX_MODEL=small
HF_TOKEN=placeholder_huggingface_token

# --- Observability & Tracing ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=placeholder_langsmith_api_key
LANGCHAIN_PROJECT=horizon-veridian
